{
  "name": "tmail",
  "version": "0.1.0",
  "description": "Dedicated Windows desktop client for Tanasuq Lark Mail",
  "author": "Tanasuq Organization for Sustainable Development",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run check && electron-builder --win nsis"
  },
  "build": {
    "appId": "org.tanasuq.tmail",
    "productName": "Tmail",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "artifactName": "Tmail-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tmail",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "10.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
